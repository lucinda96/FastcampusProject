<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.fastcampus.board.mapper.PostMapper">

    <insert id="register" parameterType="com.fastcampus.board.dto.PostDTO">
        INSERT INTO post (name,isAdmin,contents,createTime,views,categoryId,userId,fileId,updateTime)
        VALUES(#{name},#{isAdmin},#{contents},#{createTime},#{views},#{categoryId},#{userId},#{fileId},#{updateTime})
    </insert>

    <select id ="selectMyPosts" resultType="com.fastcampus.board.dto.PostDTO">
        select
            id
            ,name
            ,isAdmin
            ,contents
            ,createTime
            ,views
            ,categoryId
            ,userId
            ,fileId
            ,updateTime
        from post
        where userId = #{userId}
    </select>

    <update id="updatePosts">
        update post
        set name = #{name}
        , contents=#{contents}
        , views = #{views}
        , categoryId = #{categoryId}
        , userId = #{userId}
        , fileId = #{fileId}
        , updateTime = #{updateTime}
        where id = #{id}
    </update>

    <delete id="deletePosts">
        delete from post
        where id = #{postId}
    </delete>
</mapper>